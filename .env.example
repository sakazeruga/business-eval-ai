# OpenRouter API キー（1本で Claude / Gemini / GPT すべて使用可能）
# 取得: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Perplexity Agent API キー（競合調査・Why Now のWeb検索用）
# 取得: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# OpenRouter の Zero Data Retention 強制（既定: true）。
# 対応エンドポイントが無くリクエストが失敗する場合のみ false で切り分ける
OPENROUTER_ZDR=true
