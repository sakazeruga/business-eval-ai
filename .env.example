# OpenRouter API キー（1本で Claude / Gemini / GPT すべて使用可能）
# 取得: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Perplexity Agent API キー（競合調査・Why Now のWeb検索用）
# 取得: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# OpenRouter の Zero Data Retention 強制（既定: true）。
# 対応エンドポイントが無くリクエストが失敗する場合のみ false で切り分ける
OPENROUTER_ZDR=true

# ------------------------------------------------------------
# 利用許可（承認）
# ------------------------------------------------------------
# 管理者のメール（カンマ区切り）。/admin が使え、利用上限も受けない
ADMIN_EMAILS=you@example.com

# このドメインのメールは申請なしで自動承認（カンマ区切り、任意）
AUTO_APPROVE_DOMAINS=

# true にすると承認なしで誰でも利用できる（検証用。既定 false）
OPEN_ACCESS=false

# ------------------------------------------------------------
# 共有ストア（Upstash Redis REST）
# ------------------------------------------------------------
# 未設定ならプロセス内メモリで動く（マシン再起動で承認リストが消える）
# 取得: https://console.upstash.com/ → データベース作成 → REST の URL と TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# 利用上限（省略時は既定値）
# ------------------------------------------------------------
# LIMIT_EVALUATE_PER_USER=5
# LIMIT_RESEARCH_PER_USER=10
# LIMIT_CHAT_PER_USER=40
# LIMIT_EVALUATE_GLOBAL=60
# MAX_CONCURRENT_EVALS=4
